[Unit]
Description=Golova private Google Sheets journal
After=network-online.target
Wants=network-online.target

[Service]
User=golova
Group=golova
WorkingDirectory=/opt/golova
EnvironmentFile=/etc/golova/environment
ExecStart=/opt/golova/venv/bin/python /opt/golova/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
